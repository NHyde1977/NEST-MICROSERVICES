
generator client {
  provider = "prisma-client"
  output   = "../../apps/orders/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int
  description String
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}
